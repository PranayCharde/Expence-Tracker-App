rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read or write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Transactions subcollection: strictly isolated by user ID
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Budgets subcollection: strictly isolated by user ID
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other read/write attempts by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

